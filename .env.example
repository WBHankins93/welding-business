# ─── Neon (server-side only) ──────────────────────────────────
# Neon Dashboard > your project > Connection Details > Pooled connection
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Brevo SMTP (server-side only) ────────────────────────────
# Brevo Dashboard > SMTP & API > SMTP tab
# Host and port are always the same for Brevo; only user/pass change per account
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email@example.com
SMTP_PASS=your-brevo-smtp-key

# From address — must be a verified sender in Brevo
# Add djnservicesllc.com as a domain in Brevo > Senders & IPs > Domains
SMTP_FROM_EMAIL=notifications@djnservicesllc.com
